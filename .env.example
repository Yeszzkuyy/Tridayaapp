APP_NAME="Tridaya App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# PROD: LOG_CHANNEL=daily LOG_LEVEL=warning APP_ENV=production APP_DEBUG=false SESSION_SECURE_COOKIE=true

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# WhatsApp Gateway (Green API) — kredensial per akun diisi via WhatsApp Center (super admin)
GREEN_API_BASE_URL=https://api.green-api.com
# Meta WhatsApp Business Cloud API — verify token untuk verifikasi webhook di dashboard Meta
META_WA_VERIFY_TOKEN=
# App Secret Meta untuk verifikasi HMAC X-Hub-Signature-256 pada POST webhook (wajib di prod)
META_WA_APP_SECRET=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# file (bukan database) agar cache tidak membebani DB utama; Redis belum tersedia (tanpa ext phpredis)
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# === GOOGLE CALENDAR (Teknisi) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/teknisi/kalender/callback

# === GOOGLE MAPS (autocomplete lokasi jadwal sales) ===
# Aktifkan "Maps JavaScript API" + "Places API (New)" untuk key ini.
# Kosong = fallback GOOGLE_API_KEY; input lokasi tetap jalan tanpa autocomplete.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=id

# === SURVEY (Teknisi) ===
# URL template Google Docs untuk laporan survey (copy-link). Kosong = halaman buat dokumen baru.
SURVEY_REPORT_TEMPLATE_URL=

# === BAST (Teknisi) ===
# Link template Google Drive per perusahaan untuk dokumen BAST.
# Pakai link "Make a copy / Buat salinan" (format .../copy), contoh:
# https://docs.google.com/document/d/<ID>/copy
# Link dibuka di tab baru tanpa Google Drive API. Kosong = pilihan tidak ditampilkan.
BAST_TEMPLATE_MGK_URL=
BAST_TEMPLATE_NTI_URL=
BAST_TEMPLATE_TPS_URL=
BAST_TEMPLATE_WANI_URL=

# === WEB PUSH (VAPID) ===
# Generate di server: php artisan webpush:vapid
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# === AI (Gemini / OfficeAssistant) ===
GEMINI_API_KEY=

# === KNOWLEDGE BASE (AI / RAG) ===
KNOWLEDGE_BASE_STORE_ID=

# Product Knowledge Base (Firecrawl hanya dari backend)
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
FIRECRAWL_TIMEOUT=120
FIRECRAWL_WAIT_FOR=3000
FIRECRAWL_CRAWL_LIMIT=10
FIRECRAWL_LISTING_THRESHOLD=500
KB_IMPORT_MAX_URLS=50
KB_CHUNK_SIZE=1500
KB_CHUNK_OVERLAP=150
KNOWLEDGE_BASE_STORE_NAME="3DY Knowledge Base"
