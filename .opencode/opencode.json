{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "21st-*", "effect": "deny" },
    { "action": "skill", "resource": "context7-mcp", "effect": "deny" },
    { "action": "skill", "resource": "brand", "effect": "deny" },
    { "action": "skill", "resource": "banner-design", "effect": "deny" },
    { "action": "skill", "resource": "design", "effect": "deny" },
    { "action": "skill", "resource": "slides", "effect": "deny" },
    { "action": "skill", "resource": "find-skills", "effect": "deny" },
    { "action": "skill", "resource": "3dy-architecture", "effect": "allow" },
    { "action": "skill", "resource": "3dy-security", "effect": "allow" },
    { "action": "skill", "resource": "3dy-crm-workflow", "effect": "allow" },
    { "action": "skill", "resource": "3dy-testing", "effect": "allow" }
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {file:~/.secrets/context7-api-key}"
      }
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/var/www/3dyapp"
      ],
      "enabled": true
    },
    "testsprite": {
      "type": "local",
      "command": ["npx", "-y", "@testsprite/testsprite-mcp@latest"],
      "enabled": true,
      "environment": {
        "API_KEY": "{file:~/.secrets/testsprite-api-key}"
      }
    }
  }
}
